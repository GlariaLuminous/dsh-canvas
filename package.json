{
  "name": "dsh-canvas-workbench",
  "version": "0.1.0",
  "description": "A persistent, interactive artifact canvas for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": {"node": ">=22.18", "dsh": "0.2.1-rc.2"},
  "dsh": {
    "bundle": "./cordis.patch.yml",
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {"optional": true},
    "@deepseek-ai/dsh-tools": {"optional": true}
  },
  "devDependencies": {}
}
